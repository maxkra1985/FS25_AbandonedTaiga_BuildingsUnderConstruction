		</type>
		<!-- constructibleSawmill - строимая лесопилка -->
		<!-- constructibleSawmill - строимая лесопилка -->
		<type name="constructibleProductionPoint" parent="constructible" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="productionPoint" />
		</type>
		<!-- monomixProductionPoint - строимое производство моносмеси со складом тюков -->

		<!-- spawnAreas -->
		<i3dMapping id="spawnAreaStart01"	node="0>5|0|0" />
		<i3dMapping id="spawnAreaEnd01"		node="0>5|0|0|0" />
		<!-- storageAreas -->
		<i3dMapping id="storageAreaStart01"	node="0>5|0|1" />
		<i3dMapping id="storageAreaEnd01"	node="0>5|0|1|0" />
		<i3dMapping id="storageAreaStart02"	node="0>5|0|2" />
		<i3dMapping id="storageAreaEnd02"	node="0>5|0|2|0" />

		<!-- Storage -->
		<i3dMapping id="objectStorage" node="0>5" />

		<!-- Doors -->
		<i3dMapping id="door01"					node="0>6|15|2|1|0" />
		<i3dMapping id="occluderDoor01"			node="0>6|15|2|1|1" />
		<i3dMapping id="doorTrigger01"			node="0>6|15|2|1|2" />
		<i3dMapping id="door02"					node="0>6|15|2|2|0" />
		<i3dMapping id="occluderDoor02"			node="0>6|15|2|2|1" />
		<i3dMapping id="doorTrigger02"			node="0>6|15|2|2|2" />
		<i3dMapping id="slidingDoor2"			node="0>6|15|2|3|0" />
		<i3dMapping id="slidingDoor2Trigger"	node="0>6|15|2|3|1" />
		<i3dMapping id="slidingDoor2Sound"		node="0>6|15|2|3|2" />

		<!-- Constructible -->
		<i3dMapping id="ConstructibleSellingStation"	node="0>7" />

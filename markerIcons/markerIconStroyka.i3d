    </Material>
  </Materials>


  <Shapes externalShapesFile="markerIconStroyka.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="markerIconstroyka" nodeId="8">
      <Shape name="icon" translation="0 1 0" shapeId="1" clipDistance="300" nodeId="9" castsShadows="true" receiveShadows="true" materialIds="15"/>
      <Light name="pointLight" translation="0 1 0" clipDistance="100" nodeId="10" type="point" color="0.417119 0.506314 0.0445976" emitDiffuse="true" emitSpecular="true" range="1.5"/>
    </TransformGroup>
  </Scene>

</i3D>

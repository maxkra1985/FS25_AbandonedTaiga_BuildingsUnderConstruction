	<productionPoint>
		<productions sharedThroughputCapacity="false">
			<production id="clean_wheat" name="Очистка пшеницы" cyclesPerHour="10" costsPerActiveHour="15">
				<inputs>
					<input fillType="WHEAT" amount="1000"/>
				</inputs>
				<outputs>
					<output fillType="WHEAT_CLEAN" amount="900"/>
					<output fillType="GRAINWASTE" amount="100"/>
				</outputs>
			</production>
			<production id="clean_barley" name="Очистка ячменя" cyclesPerHour="10" costsPerActiveHour="15">
				<inputs>
					<input fillType="BARLEY" amount="1000"/>
				</inputs>
				<outputs>
					<output fillType="BARLEY_CLEAN" amount="900"/>
					<output fillType="GRAINWASTE" amount="100"/>
				</outputs>

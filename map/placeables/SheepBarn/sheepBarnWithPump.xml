	<base>
		<filename>map/placeables/SheepBarn/sheepBarn.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>

	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testArea1Start" endNode="testArea1End" />
		</testAreas>
		<sounds>
			<place template="largeImp" />
			<placeLayered template="sheepLayer" />
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
		<clearArea startNode="clearArea2Start" widthNode="clearArea2Width" heightNode="clearArea2Height"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="20">
		<levelAreas>
			<levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="dirt"/>
		</levelAreas>
	</leveling>

	<foliageAreas>
		<foliageArea startNode="foliageArea1Start" widthNode="foliageArea1Width" heightNode="foliageArea1Height" decoFoliage="grassShort" />
		<foliageArea startNode="foliageArea2Start" widthNode="foliageArea2Width" heightNode="foliageArea2Height" decoFoliage="grassShort" />
		<foliageArea startNode="foliageArea3Start" widthNode="foliageArea3Width" heightNode="foliageArea3Height" decoFoliage="grassShort" />
	</foliageAreas>

	<indoorAreas>
		<indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
		<indoorArea startNode="indoorArea2Start" widthNode="indoorArea2Width" heightNode="indoorArea2Height"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
		</updateAreas>
	</ai>

	<triggerMarkers>
		<triggerMarker node="markerFoodLeft" filename="$data/shared/assets/marker/markerIconFood.i3d" adjustToGround="true" />
		<triggerMarker node="markerFoodRight" filename="$data/shared/assets/marker/markerIconFood.i3d"  adjustToGround="true"/>
		<triggerMarker node="markerAnimals" filename="$data/shared/assets/marker/markerIconAnimals.i3d" adjustToGround="true"/>
		<triggerMarker node="markerBale" filename="$data/shared/assets/marker/markerIconBales.i3d" adjustToGround="true"/>
	</triggerMarkers>

	<hotspots>
		<hotspot type="UNLOADING_PALLET"	linkNode="unloadTriggerMarker"	teleportNode="unloadTriggerMarker" />
		<hotspot type="SHEEP"												teleportNode="teleportNode" />
	</hotspots>

	<animatedObjects>
		<animatedObject saveId="door01" >
			<animation duration="2.5">
				<part node="door01">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -115 0"/>
				</part>
			</animation>
			<controls triggerNode="door01Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
			<sounds>
				<moving linkNode="door01" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="door01" template="woodDoorOpen" />
				<negEnd linkNode="door01" template="woodDoorCloseRandom" />
			</sounds>
		</animatedObject>
	</animatedObjects>

	<infoTrigger triggerNode="infoTrigger" />

	<husbandry saveId="Animals_SHEEP" hasStatistics="false">
		<water automaticWaterSupply="true" >
			<waterPlaces>
				<waterPlace node="waterPlace01" />
				<waterPlace node="waterPlace02" />
				<waterPlace node="waterPlace03" />
				<waterPlace node="waterPlace04" />
				<waterPlace node="waterPlace05" />
				<waterPlace node="waterPlace06" />
			</waterPlaces>
		</water>

		<animals type="SHEEP" maxNumAnimals="250" maxNumVisualAnimals="250">
			<navigation rootNode="navigationRootNode" filename="map/placeables/SheepBarn/NavMesh.i3d" />
			<loadingTrigger node="animalLoadingTrigger" />
		</animals>

		<food capacity="60000" >
			<foodPlane node="fillVolumeFood" minY="-0.47" maxY="-0.1" changeVisibility="true" defaultFillType="DRYGRASS_WINDROW" />
			<unloadTrigger exactFillRootNode="exactFillRootNodeFood"/>
			<baleTrigger triggerNode="baleTrigger"/>
			<foodPlaces>
				<foodPlace node="foodPlace01" />
				<foodPlace node="foodPlace02" />
				<foodPlace node="foodPlace03" />
				<foodPlace node="foodPlace04" />
				<foodPlace node="foodPlace05" />
				<foodPlace node="foodPlace06" />
				<foodPlace node="foodPlace07" />
				<foodPlace node="foodPlace08" />
				<foodPlace node="foodPlace09" />
			</foodPlaces>
		</food>

		<pallets>
			<palletSpawner fillTypes="WOOL GOATMILK" maxNumPallets="35">
				<palletTrigger node="palletTrigger" />
				<spawnPlaces>
					<spawnPlace startNode="palletArea1Start" endNode="palletArea1End" />
					<spawnPlace startNode="palletArea2Start" endNode="palletArea2End" />
					<spawnPlace startNode="palletArea3Start" endNode="palletArea3End" />
					<spawnPlace startNode="palletArea4Start" endNode="palletArea4End" />
					<spawnPlace startNode="palletArea5Start" endNode="palletArea5End" />
					<spawnPlace startNode="palletArea6Start" endNode="palletArea6End" />
					<spawnPlace startNode="palletArea7Start" endNode="palletArea7End" />
					<spawnPlace startNode="palletArea8Start" endNode="palletArea8End" />
					<spawnPlace startNode="palletArea9Start" endNode="palletArea9End" />
					<spawnPlace startNode="palletArea10Start" endNode="palletArea10End" />
				</spawnPlaces>
			</palletSpawner>
		</pallets>
	</husbandry>

	<constructible>
		<stateMachine>
			<states>
				<state name="SETUP" StateName="Установка опор каркаса" class="ConstructibleStateBuilding" >
					<toggleMesh node="fenceNodes"			active="false"	updatePhysics="false"/>
					<toggleMesh node="husbandry"			active="false"	updatePhysics="false"/>
					<toggleMesh node="supportPillars"		active="false"	updatePhysics="false"/>
					<toggleMesh node="crossMounts"			active="false"	updatePhysics="false"/>
					<toggleMesh node="walls"				active="false"	updatePhysics="false"/>
					<toggleMesh node="floorBeams"			active="false"	updatePhysics="false"/>
					<toggleMesh node="rafters"				active="false"	updatePhysics="false"/>
					<toggleMesh node="lathings"				active="false"	updatePhysics="false"/>
					<toggleMesh node="roofs"				active="false"	updatePhysics="false"/>
					<toggleMesh node="water"				active="false"	updatePhysics="false"/>
					<toggleMesh node="pumpTankStation"		active="false"	updatePhysics="false"/>
					<toggleMesh node="fences"				active="false"	updatePhysics="false"/>
					<toggleMesh node="furniture"			active="false"	updatePhysics="false"/>
					<toggleHotspot index="1" isVisible="true" />
					<toggleHotspot index="2" isVisible="false" />
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="33"/>			<!-- начинаем ставить столбы каркаса -->
					<input fillType="WOODBEAM"				amount="2998"	usagePerHour="1000"/>
					<input fillType="NAILS"				amount="57"	usagePerHour="20"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_1" StateName="Монтаж каркаса" class="ConstructibleStateBuilding" >
					<toggleMesh node="supportPillars"		active="true"	updatePhysics="true"/>		<!-- столбы каркаса установлены -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="33"/>			<!-- устанавливаем поперечные крепления -->
					<input fillType="WOODBEAM"				amount="2998"	usagePerHour="1000"/>
					<input fillType="NAILS"				amount="57"	usagePerHour="20"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_2" StateName="Обшивка стен каркаса" class="ConstructibleStateBuilding" >
					<toggleMesh node="crossMounts"			active="true"	updatePhysics="true"/>		<!-- поперечины установлены -->
					<input fillType="INSTRUMENT"			amount="149"	usagePerHour="30"/>			<!-- обиваем стены досками -->
					<input fillType="PLANKS"				amount="4998"	usagePerHour="1000"/>
					<input fillType="BOARDS"				amount="998"	usagePerHour="200"/>
					<input fillType="NAILS"				amount="97"	usagePerHour="20"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_3" StateName="Укладываем балки перекрытия" class="ConstructibleStateBuilding" >
					<toggleMesh node="walls"				active="true"	updatePhysics="true"/>		<!-- стены обшиты -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="33"/>			<!-- укладываем балки перекрытия -->
					<input fillType="WOODBEAM"				amount="2998"	usagePerHour="1000"/>
					<input fillType="NAILS"				amount="57"	usagePerHour="20"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_4" StateName="Монтаж стропил" class="ConstructibleStateBuilding" >
					<toggleMesh node="floorBeams"			active="true"	updatePhysics="true"/>		<!-- перекрытия установлены -->
					<input fillType="INSTRUMENT"			amount="49"		usagePerHour="50"/>			<!-- устанавливаем стропила -->
					<input fillType="WOODBEAM"				amount="2998"	usagePerHour="3000"/>
					<input fillType="NAILS"				amount="47"	usagePerHour="50"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_5" StateName="Набивка обрешётки" class="ConstructibleStateBuilding" >
					<toggleMesh  node="rafters"				active="true"	updatePhysics="true"/>		<!-- стропила установлены -->
					<input fillType="INSTRUMENT"			amount="49"		usagePerHour="50"/>			<!-- набиваем обрешётку -->
					<input fillType="PLANKS"				amount="998"	usagePerHour="1000"/>
					<input fillType="BOARDS"				amount="998"	usagePerHour="1000"/>
					<input fillType="NAILS"				amount="77"	usagePerHour="80"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_6" StateName="Монтаж кровли" class="ConstructibleStateBuilding" >
					<toggleMesh node="lathings"		active="true"	updatePhysics="true"/>				<!-- обрешётка набита -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="50"/>			<!-- укладываем крышу -->
					<input fillType="ROOFPLATES"			amount="4995"	usagePerHour="2500"/>
					<input fillType="NAILS"				amount="47"	usagePerHour="24"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>

				<state name="BUILDING_7" StateName="Монтаж ёмкостей воды" class="ConstructibleStateBuilding" >
					<toggleMesh node="roofs"				active="true"	updatePhysics="true"/>		<!-- крыша уложена -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="50"/>			<!-- устанавливаем ёмкости с водой -->
					<input fillType="METAL"					amount="1995"	usagePerHour="1000"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>

				<state name="BUILDING_8" StateName="Монтаж водного насоса" class="ConstructibleStateBuilding" >
					<toggleMesh node="water"				active="true"	updatePhysics="true"/>		<!-- ёмкости с водой установлены -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="50"/>			<!-- устанавливаем насос с бочкой -->
					<input fillType="METAL"					amount="1995"	usagePerHour="1000"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_9" StateName="Установка ограждения" class="ConstructibleStateBuilding" >
					<toggleMesh node="pumpTankStation"		active="true"	updatePhysics="true"/>		<!-- насос с бочкой установлены -->
					<input fillType="INSTRUMENT"			amount="99"		usagePerHour="50"/>			<!-- устанавливаем забор -->
					<input fillType="BOARDS"				amount="4998"	usagePerHour="2500"/>
					<input fillType="NAILS"				amount="77"	usagePerHour="40"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="BUILDING_10" StateName="Обустройство постройки" class="ConstructibleStateBuilding" >
					<toggleMesh node="fences"				active="true"	updatePhysics="true"/>	<!-- установили забор -->
					<input fillType="INSTRUMENT"			amount="49"		usagePerHour="50"/>		<!-- готовимся к финалу, завершаем стройку -->
					<input fillType="BUILDING_METAL"		amount="999"	usagePerHour="1000"/>
					<input fillType="BOARDS"				amount="998"	usagePerHour="1000"/>
					<input fillType="NAILS"				amount="57"	usagePerHour="60"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>

				<state name="FINALIZE" class="ConstructibleStateFinalize" >
					<toggleMesh node="furniture"			active="true"	updatePhysics="true"/>
					<toggleMesh node="husbandry"			active="true"	updatePhysics="true"/>
					<toggleMesh node="ConstructibleSellingStation"	active="false"	updatePhysics="true"/>
					<toggleHotspot index="1" isVisible="false" />
					<toggleHotspot index="2" isVisible="true" />
				</state>

				<state name="DONE" class="ConstructibleState" isPreviewState="true"/>
			</states>

			<transitions>
				<transition from="SETUP"		to="BUILDING_1"/>
				<transition from="BUILDING_1"	to="BUILDING_2"/>
				<transition from="BUILDING_2"	to="BUILDING_3"/>
				<transition from="BUILDING_3"	to="BUILDING_4"/>
				<transition from="BUILDING_4"	to="BUILDING_5"/>
				<transition from="BUILDING_5"	to="BUILDING_6"/>
				<transition from="BUILDING_6"	to="BUILDING_7"/>
				<transition from="BUILDING_7"	to="BUILDING_8"/>
				<transition from="BUILDING_8"	to="BUILDING_9"/>
				<transition from="BUILDING_9"	to="BUILDING_10"/>
				<transition from="BUILDING_10"	to="FINALIZE"/>
				<transition from="FINALIZE"		to="DONE" />
			</transitions>
		</stateMachine>

		<sellingStation node="constructiblesSellingStation" supportsExtension="false" allowMissions="true" appearsOnStats="false">
			<palletTrigger	triggerNode="ConstructiblePalletTrigger"	aiNode="unloadTriggerAINode"	fillTypes="INSTRUMENT WOODBEAM BOARDS PLANKS ROOFPLATES BUILDING_METAL METAL NAILS" />
		</sellingStation>

		<storage isExtension="false" fillLevelSyncThreshold="50">		<!-- ВРЕМЯ     23 -->
			<capacity fillType="INSTRUMENT"		capacity="1000" />		<!-- ВСЕГО  1 000 -->
			<capacity fillType="WOODBEAM"		capacity="5000" />		<!-- ВСЕГО 12 000 -->
			<capacity fillType="BOARDS"			capacity="5000" />		<!-- ВСЕГО  8 000 -->
			<capacity fillType="PLANKS"			capacity="5000" />		<!-- ВСЕГО  6 000 -->
			<capacity fillType="ROOFPLATES"		capacity="5000" />		<!-- ВСЕГО  5 000 -->
			<capacity fillType="BUILDING_METAL"	capacity="1000" />		<!-- ВСЕГО  1 000 -->
			<capacity fillType="METAL"			capacity="4000" />
			<capacity fillType="NAILS"			capacity="600" />		<!-- ВСЕГО  4 000 -->
		</storage>
	</constructible>


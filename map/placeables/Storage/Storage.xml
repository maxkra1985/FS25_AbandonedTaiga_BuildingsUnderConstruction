		<!-- triggerMarkers -->
		<i3dMapping id="objectTrigger" node="0>5|1" />
		<i3dMapping id="objectTriggerMarker" node="0>5|1|0" />
		<i3dMapping id="playerTrigger" node="0>5|2" />
		<i3dMapping id="playerTriggerMarker" node="0>5|2|0" />

	<animatedObjects>
		<animatedObject saveId="rollingDoor01">
			<animation duration="5">
				<part node="rollingDoor1"><keyFrame time="0.0" translation="0 0 0"/><keyFrame time="1.0" translation="0 3.4 0"/></part>
				<part node="rollingDoor1ColBottom"><keyFrame time="0.0" translation="0 0 0"/><keyFrame time="1.0" translation="0 3.4 0"/></part>
				<part node="rollingDoor1ColTop"><keyFrame time="0.0" translation="0 0 0"/><keyFrame time="0.5" translation="0 0 0"/><keyFrame time="1.0" translation="0 1.7 0"/></part>
				<shader node="rollingDoor1" parameterName="visibilityCutThreshold"><keyFrame time="0.0" values="0 - - -"/><keyFrame time="1.0" values="0.94 - - -"/></shader>
			</animation>
			<controls triggerNode="rollingDoor1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
			<sounds>
				<moving linkNode="rollingDoor1Base" template="rollingGarageDoor"/>
				<posEnd linkNode="rollingDoor1Base" template="slidingGateMetalOpen"/>
				<negEnd linkNode="rollingDoor1Base" template="slidingGateMetalClose"/>
			</sounds>
		</animatedObject>
		<animatedObject saveId="rollingDoor02">
			<animation duration="5">
				<part node="rollingDoor2"><keyFrame time="0.0" translation="0 0 0"/><keyFrame time="1.0" translation="0 3.4 0"/></part>

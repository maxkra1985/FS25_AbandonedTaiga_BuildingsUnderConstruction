<?xml version="1.0" encoding="UTF-8"?>
<placeable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" type="productionPointWithStorage" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>$l10n_storeItem_MonomixProductionWorkshop</name>
		<functions>
			<function>$l10n_function_MonomixProductionWorkshop</function>
		</functions>
		<image>ConstructibleBuildings.dds</image>
		<price>100</price>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>productionPoints</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
	</storeData>

	<base>
		<filename>map/placeables/MonomixProductionWorkshop/MonomixProductionWorkshop.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testArea1Start" endNode="testArea1End"/>
		</testAreas>
		<sounds>
			<place template="medImp"/>
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
		<levelAreas>
			<levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="gravel"/>
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger"/>

	<!--
		Стартовый рецепт моносмеси: 45% сена, 45% силоса и 10% соломы.
		Пропорции находятся внутри штатных диапазонов рецепта FORAGE FS25.
		Производительность и ёмкости оставлены как стартовый баланс для дальнейшей настройки.
	-->
	<productionPoint isFinalized="false" name="$l10n_storeItem_MonomixProductionWorkshop">
		<productions sharedThroughputCapacity="true">
			<production id="forage" name="$l10n_fillType_forage" cyclesPerHour="10" costsPerActiveHour="20">
				<inputs>
					<input fillType="DRYGRASS_WINDROW" amount="450"/>
					<input fillType="SILAGE" amount="450"/>
					<input fillType="STRAW" amount="100"/>
				</inputs>
				<outputs>
					<output fillType="FORAGE" amount="1000"/>
				</outputs>
			</production>
		</productions>

		<!--
			Производственные механизмы. Штатный ProductionPoint запускает эти
			RotationAnimation при включении производства и останавливает при выключении.
		-->
		<animationNodes>
			<!-- Вентиляторы: все шесть роторов вращаются вокруг своей локальной оси Z. -->
			<animationNode rotSpeed="600" rotAxis="3" turnOnFadeTime="1" turnOffFadeTime="1">
				<node node="ventRotor01"/>
				<node node="ventRotor02"/>
				<node node="ventRotor03"/>
				<node node="ventRotor04"/>
				<node node="ventRotor05"/>
				<node node="ventRotor06"/>
			</animationNode>

			<!-- Кормосмеситель IT26: главный барабан вращается встречно двум малым. -->
			<animationNode rotSpeed="200" rotAxis="3" turnOnFadeTime="1" turnOffFadeTime="1">
				<node node="it26MainDrumPivot" speedScale="-1"/>
				<node node="it26TopDrumPivot" speedScale="1"/>
				<node node="it26BottomDrumPivot" speedScale="1"/>
			</animationNode>
			<animationNode node="it26Fan" rotSpeed="600" rotAxis="1" turnOnFadeTime="1" turnOffFadeTime="1"/>

			<!-- Кормосмеситель BSL Knight 3300. -->
			<animationNode rotSpeed="200" rotAxis="3" turnOnFadeTime="1" turnOffFadeTime="1">
				<node node="knightMainDrum" speedScale="-1"/>
				<node node="knightTopDrum" speedScale="1"/>
				<node node="knightBottomDrum" speedScale="1"/>
			</animationNode>
		</animationNodes>

		<!-- Общий пул 450000 л даёт BunkerFillPlanes по 150000 л на каждый из трёх физических бункеров. -->
		<storage isExtension="false" capacity="450000" fillTypes="DRYGRASS_WINDROW SILAGE STRAW FORAGE" fillLevelSyncThreshold="50">
			<!-- Текущее положение поверхности соответствует 100% (+1 м по миру); пустой бункер опускает её на 5.45 м. -->
			<bunkerFillPlane node="hayFillPlane" fillTypes="DRYGRASS_WINDROW" minY="-5.45" maxY="0"/>
			<bunkerFillPlane node="silageFillPlane" fillTypes="SILAGE" minY="-5.45" maxY="0"/>
			<bunkerFillPlane node="strawFillPlane" fillTypes="STRAW" minY="-5.45" maxY="0"/>

			<!-- Оба кормосмесителя отображают фактический уровень готовой моносмеси FORAGE. -->
			<!-- Если динамический fill plane не создастся, полный объём показывается только при включённом рецепте forage. -->
			<productionFillVolume node="knightFillVolume" fillType="FORAGE" visualFillType="SILAGE" fallbackProductionId="forage"/>
			<productionFillVolume node="it26FillVolume" fillType="FORAGE" visualFillType="SILAGE" fallbackProductionId="forage"/>
		</storage>

		<sellingStation node="productionPoint" appearsOnStats="false" allowMissions="false" supportsExtension="false" hideFromPricesMenu="true" suppressWarnings="true">
			<supportedFillTypes>
				<fillType name="DRYGRASS_WINDROW"/>
				<fillType name="SILAGE"/>
				<fillType name="STRAW"/>
			</supportedFillTypes>
			<unloadTrigger exactFillRootNode="bulkHayFillRootNode" aiNode="bulkHayAiUnloadingNode" fillTypes="DRYGRASS_WINDROW"/>
			<unloadTrigger exactFillRootNode="bulkSillageFillRootNode" aiNode="bulkSillageAiUnloadingNode" fillTypes="SILAGE"/>
			<unloadTrigger exactFillRootNode="bulkStrawFillRootNode" aiNode="bulkStrawAiUnloadingNode" fillTypes="STRAW"/>
		</sellingStation>

		<!-- Используем существующий trigger у производственного узла как точку выдачи готовой моносмеси. -->
		<loadingStation fillTypes="FORAGE" supportsExtension="false">
			<loadTrigger triggerNode="forageLoadTrigger" dischargeNode="forageLoadDischargeNode" aiNode="forageLoadAiNode" fillTypes="FORAGE" fillLitersPerSecond="3000"/>
		</loadingStation>

		<playerTrigger node="playerTrigger"/>
	</productionPoint>

	<!-- Отдельный физический склад тюков сена и соломы. -->
	<objectStorage supportsBales="true" supportsPallets="false" capacity="120" maxUnloadAmount="50" maxLength="2.5" maxWidth="2.5" maxHeight="2.5" fillTypes="DRYGRASS_WINDROW STRAW SILAGE">
		<playerTrigger node="storagePlayerTrigger"/>
		<objectTrigger node="baleTrigger"/>
		<spawnAreas>
			<spawnArea startNode="baleSpawnAreaStart01" endNode="baleSpawnAreaEnd01" maxHeight="2.5"/>
			<spawnArea startNode="baleSpawnAreaStart02" endNode="baleSpawnAreaEnd02" maxHeight="2.5"/>
		</spawnAreas>
		<storageAreas>
			<storageArea startNode="baleStorageAreaStart01" endNode="baleStorageAreaEnd01" maxHeight="2.5"/>
		</storageAreas>
	</objectStorage>

	<triggerMarkers>
		<triggerMarker node="constructibleUnloadTriggerMarker"	adjustToGround="true"	filename="markerIcons/markerIconStroyka.i3d"/>
		<triggerMarker node="playerTriggerMarker"				adjustToGround="false"	filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
		<triggerMarker node="palletTrigger"						adjustToGround="false"	filename="markerIcons/markerIconMineralFeedPallet.i3d"/>
		<triggerMarker node="bulkHayUnloadLinkNode"				adjustToGround="true"	filename="markerIcons/markerIconHay.i3d"/>
		<triggerMarker node="bulkSillageUnloadLinkNode"			adjustToGround="true"	filename="markerIcons/markerIconSilage.i3d"/>
		<triggerMarker node="bulkStrawUnloadLinkNode"			adjustToGround="true"	filename="markerIcons/markerIconStraw.i3d"/>
		<triggerMarker node="baleUnloadLinkNode"				adjustToGround="false"	filename="markerIcons/markerIconBaleStorage.i3d"/>
		<triggerMarker node="storagePlayerTriggerMarker"		adjustToGround="false"	filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
	</triggerMarkers>

	<hotspots>
		<hotspot type="UNLOADING_PALLET" linkNode="constructibleUnloadTriggerMarker" teleportNode="constructibleUnloadTriggerMarker"/>
		<hotspot type="PRODUCTION_POINT" linkNode="playerTriggerMarker" teleportNode="playerTriggerMarker"/>
	</hotspots>

	<animatedObjects>
		<!-- Подъёмные ворота. Конфигурация повторяет штатную механику rolling door. -->
		<animatedObject saveId="monomixRollingDoor01">
			<animation duration="5">
				<part node="rollingDoor1">
					<keyFrame time="0.0" translation="0 0 0"/>
					<keyFrame time="1.0" translation="0 3.8 0"/>
				</part>
				<part node="rollingDoor1ColPartBottom">
					<keyFrame time="0.0" translation="0 0 0"/>
					<keyFrame time="1.0" translation="0 3.8 0"/>
				</part>
				<part node="rollingDoor1ColPartTop">
					<keyFrame time="0.0" translation="0 0 0"/>
					<keyFrame time="0.5" translation="0 0 0"/>
					<keyFrame time="1.0" translation="0 1.9 0"/>
				</part>
				<shader node="rollingDoor1" parameterName="visibilityCutThreshold">
					<keyFrame time="0.0" values="0 - - -"/>
					<keyFrame time="1.0" values="0.94 - - -"/>
				</shader>
			</animation>
			<controls triggerNode="rollingDoor1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
			<sounds>
				<moving linkNode="rollingDoor1Base" template="rollingGarageDoor"/>
				<posEnd linkNode="rollingDoor1Base" template="slidingGateMetalOpen"/>
				<negEnd linkNode="rollingDoor1Base" template="slidingGateMetalClose"/>
			</sounds>
		</animatedObject>

		<!-- Передние двустворчатые распашные ворота. -->
		<animatedObject saveId="monomixDoubleGateFront">
			<animation duration="2.5">
				<part node="frontGateLeftDoor">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 90 0"/>
				</part>
				<part node="frontGateRightDoor">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -90 0"/>
				</part>
			</animation>
			<controls triggerNode="frontGateTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
		</animatedObject>

		<!-- Задние двустворчатые распашные ворота. -->
		<animatedObject saveId="monomixDoubleGateRear">
			<animation duration="2.5">
				<part node="rearGateLeftDoor">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 90 0"/>
				</part>
				<part node="rearGateRightDoor">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 -90 0"/>
				</part>
			</animation>
			<controls triggerNode="rearGateTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
		</animatedObject>

		<!-- Одиночная распашная дверь. -->
		<animatedObject saveId="monomixSingleDoor">
			<animation duration="1.2">
				<part node="singleDoorLeaf">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 105 0"/>
				</part>
			</animation>
			<controls triggerNode="singleDoorTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
			<sounds>
				<moving linkNode="singleDoorLeaf" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="singleDoorLeaf" template="woodDoorOpen"/>
				<negEnd linkNode="singleDoorLeaf" template="woodDoorCloseRandom"/>
			</sounds>
		</animatedObject>

		<!-- Одиночная распашная дверь в администрацию. -->
		<animatedObject saveId="monomixSingleDoor2">
			<animation duration="1.2">
				<part node="singleDoor2Leaf">
					<keyFrame time="0.0" rotation="0 0 0"/>
					<keyFrame time="1.0" rotation="0 105 0"/>
				</part>
			</animation>
			<controls triggerNode="singleDoor2Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
			<sounds>
				<moving linkNode="singleDoor2Leaf" template="woodDoorSqueaksSmall" pitchScale="0.8"/>
				<posEnd linkNode="singleDoor2Leaf" template="woodDoorOpen"/>
				<negEnd linkNode="singleDoor2Leaf" template="woodDoorCloseRandom"/>
			</sounds>
		</animatedObject>
	</animatedObjects>

	<constructible>
		<stateMachine>
			<states>
				<state name="SETUP" class="ConstructibleStateBuilding" StateName="Монтаж арматуры">
					<!-- Функциональные узлы активируются только после завершения строительства. -->
					<toggleMesh node="productionPoint" active="false" updatePhysics="true"/>
					<toggleMesh node="baleWarehouse" active="false" updatePhysics="true"/>
					<toggleMesh node="constructibleSellingStation" active="true" updatePhysics="true"/>
					<toggleHotspot index="1" isVisible="true"/>
					<toggleHotspot index="2" isVisible="false"/>

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_01" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_01_props01" updatePhysics="true" progressStepMin="1" progressStepMax="34"/>
					<toggleProgressMesh node="phase_01_props02" updatePhysics="true" progressStepMin="33" progressStepMax="67"/>
					<toggleProgressMesh node="phase_01_props03" updatePhysics="true" progressStepMin="66" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="50" usagePerHour="17"/>
					<input fillType="BUILDING_METAL" amount="5000" usagePerHour="1667"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>
				<state name="BUILDING_1" class="ConstructibleStateBuilding" StateName="Монтаж опалубки">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_02" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_02_props01" updatePhysics="true" progressStepMin="1" progressStepMax="34"/>
					<toggleProgressMesh node="phase_02_props02" updatePhysics="true" progressStepMin="33.333333" progressStepMax="66.666667"/>
					<toggleProgressMesh node="phase_02_props03" updatePhysics="true" progressStepMin="66.666667" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="100" usagePerHour="50"/>
					<input fillType="BOARDS" amount="2000" usagePerHour="1000"/>
					<input fillType="PLANKS" amount="4000" usagePerHour="2000"/>
					<input fillType="NAILS" amount="100" usagePerHour="50"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_2" class="ConstructibleStateBuilding" StateName="Заливка фундамента">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_03" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_03_props01" updatePhysics="true" progressStepMin="1" progressStepMax="20"/>
					<toggleProgressMesh node="phase_03_props02" updatePhysics="true" progressStepMin="20" progressStepMax="40"/>
					<toggleProgressMesh node="phase_03_props03" updatePhysics="true" progressStepMin="40" progressStepMax="60"/>
					<toggleProgressMesh node="phase_03_props04" updatePhysics="true" progressStepMin="60" progressStepMax="80"/>
					<toggleProgressMesh node="phase_03_props05" updatePhysics="true" progressStepMin="80" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="60" usagePerHour="10"/>
					<input fillType="CEMENT" amount="15000" usagePerHour="1500"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>
				<state name="BUILDING_3" class="ConstructibleStateBuilding" StateName="Возведение стен сруба">
					<!-- Прячем опалубку и арматуру -->
					<toggleMesh node="phase_01" active="false" updatePhysics="true"/>
					<toggleMesh node="phase_02" active="false" updatePhysics="true"/>
					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_04" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_04_props01" updatePhysics="true" progressStepMin="1" progressStepMax="27"/>
					<toggleProgressMesh node="phase_04_props02" updatePhysics="true" progressStepMin="23" progressStepMax="52"/>
					<toggleProgressMesh node="phase_04_props03" updatePhysics="true" progressStepMin="48" progressStepMax="77"/>
					<toggleProgressMesh node="phase_04_props04" updatePhysics="true" progressStepMin="73" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="120" usagePerHour="10"/>
					<input fillType="WOODBEAM" amount="36000" usagePerHour="3000"/>
					<input fillType="NAILS" amount="300" usagePerHour="25"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_4" class="ConstructibleStateBuilding" StateName="Возведение фронтонов">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_05" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_05_props01" updatePhysics="true" progressStepMin="1" progressStepMax="55"/>
					<toggleProgressMesh node="phase_05_props02" updatePhysics="true" progressStepMin="45" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="80" usagePerHour="10"/>
					<input fillType="WOODBEAM" amount="10000" usagePerHour="1250"/>
					<input fillType="NAILS" amount="100" usagePerHour="12.5"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_5" class="ConstructibleStateBuilding" StateName="Монтаж стропильной системы">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_06" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_06_props01" updatePhysics="true" progressStepMin="1" progressStepMax="55"/>
					<toggleProgressMesh node="phase_06_props02" updatePhysics="true" progressStepMin="45" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="60" usagePerHour="12"/>
					<input fillType="WOODBEAM" amount="5000" usagePerHour="1000"/>
					<input fillType="NAILS" amount="100" usagePerHour="20"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_6" class="ConstructibleStateBuilding" StateName="Монтаж обрешётки и кровли">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_07" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_07_props01" updatePhysics="true" progressStepMin="0" progressStepMax="18"/>
					<toggleProgressMesh node="phase_07_props02" updatePhysics="true" progressStepMin="15" progressStepMax="35"/>
					<toggleProgressMesh node="phase_07_props03" updatePhysics="true" progressStepMin="32" progressStepMax="52"/>
					<toggleProgressMesh node="phase_07_props04" updatePhysics="true" progressStepMin="49" progressStepMax="68"/>
					<toggleProgressMesh node="phase_07_props05" updatePhysics="true" progressStepMin="65" progressStepMax="85"/>
					<toggleProgressMesh node="phase_07_props06" updatePhysics="true" progressStepMin="82" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="200" usagePerHour="20"/>
					<input fillType="PLANKS" amount="10000" usagePerHour="1000"/>
					<input fillType="BOARDS" amount="3000" usagePerHour="300"/>
					<input fillType="NAILS" amount="150" usagePerHour="15"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_7" class="ConstructibleStateBuilding" StateName="Монтаж оборудования и коммуникаций">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_08" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_08_props01" updatePhysics="true" progressStepMin="0" progressStepMax="25"/>
					<toggleProgressMesh node="phase_08_props02" updatePhysics="true" progressStepMin="25" progressStepMax="50"/>
					<toggleProgressMesh node="phase_08_props03" updatePhysics="true" progressStepMin="50" progressStepMax="75"/>
					<toggleProgressMesh node="phase_08_props04" updatePhysics="true" progressStepMin="75" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="450" usagePerHour="45"/>
					<input fillType="CEMENT" amount="2000" usagePerHour="200"/>
					<input fillType="BUILDING_METAL" amount="10000" usagePerHour="1000"/>
					<input fillType="METAL" amount="10000" usagePerHour="1000"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>
				<state name="BUILDING_8" class="ConstructibleStateBuilding" StateName="Монтаж окон, дверей и оснащения">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_09" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_09_props01" updatePhysics="true" progressStepMin="0" progressStepMax="50"/>
					<toggleProgressMesh node="phase_09_props02" updatePhysics="true" progressStepMin="50" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="120" usagePerHour="15"/>
					<input fillType="METAL" amount="5000" usagePerHour="625"/>
					<input fillType="FURNITURE" amount="5000" usagePerHour="625"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>

				<state name="FINALIZE" class="ConstructibleStateFinalize">
					<toggleMesh node="productionPoint" active="true" updatePhysics="true"/>

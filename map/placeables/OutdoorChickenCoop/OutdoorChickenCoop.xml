				<object filename="map/placeables/OutdoorChickenCoop/OutdoorChickenCoop.i3d">
					<node node="4"/>
				</object>
			</objectBundle>
		</storeIconRendering>
		<vertexBufferMemoryUsage>109568</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>22528</indexBufferMemoryUsage>
		<textureMemoryUsage>983040</textureMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>

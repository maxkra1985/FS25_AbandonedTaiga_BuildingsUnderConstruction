		<price>100</price>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<dailyUpkeep>0</dailyUpkeep>
		<species>placeable</species>
		<category>animalpens</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesHusbandry</tab>
		</brush>
		<storeIconRendering>
			<objectBundle>
				<object filename="map/placeables/SheepBarn/sheepBarn.i3d">
					<node node="4"/>
				</object>
			</objectBundle>
		</storeIconRendering>
		<vertexBufferMemoryUsage>372736</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>88576</indexBufferMemoryUsage>
		<textureMemoryUsage>6094848</textureMemoryUsage>
		<audioMemoryUsage>0</audioMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

	<placeableTypes>
		<!-- constructibleChickenHusbandry - строимый курятник -->
		<type name="constructibleChickenHusbandry" parent="constructible" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="husbandry" />
			<specialization name="husbandryAnimals" />

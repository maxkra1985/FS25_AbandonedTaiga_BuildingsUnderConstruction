<?xml version="1.0" encoding="UTF-8"?>
<placeable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" type="productionPointWithStorage" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>$l10n_storeItem_MilkProcessingPlant</name>
		<functions>
			<function>$l10n_function_MilkProcessingPlant</function>
		</functions>
		<image>map/placeables/MilkProcessingPlant/MilkProcessingPlant_icon.dds</image>
		<price>100</price>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>productionPoints</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesProductionPoint</tab>
		</brush>
	</storeData>

	<base>
		<filename>map/placeables/MilkProcessingPlant/MilkProcessingPlant.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true">
		<testAreas>
			<testArea startNode="testArea1Start" endNode="testArea1End"/>
		</testAreas>
		<sounds>
			<place template="medImp"/>
		</sounds>
	</placement>

	<clearAreas>
		<clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
	</clearAreas>

	<leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
		<levelAreas>
			<levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="gravel"/>
		</levelAreas>
	</leveling>

	<indoorAreas>
		<indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
	</indoorAreas>

	<tipOcclusionUpdateAreas>
		<tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
	</tipOcclusionUpdateAreas>

	<ai>
		<updateAreas>
			<updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
		</updateAreas>
	</ai>

	<infoTrigger triggerNode="infoTrigger"/>

	<!--
		Стандартные рецепты молочного производства FS25.
		Вода имеет отдельную ёмкость, но в текущих рецептах не расходуется.
		Для жидкостей в данной модели только exactFillRootNodeWater имеет физический Shape.
	-->
	<productionPoint isFinalized="false" name="$l10n_storeItem_MilkProcessingPlant">
		<!-- Вращение восьми мешалок и четырёх вентиляторов при активном производстве. -->
		<animationNodes>
			<animationNode node="milkRotor01" rotSpeed="700" rotAxis="3" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkRotor02" rotSpeed="700" rotAxis="3" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkRotor03" rotSpeed="700" rotAxis="3" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkRotor04" rotSpeed="700" rotAxis="3" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer01" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer02" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer03" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer04" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer05" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer06" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer07" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
			<animationNode node="milkMixer08" rotSpeed="170" rotAxis="2" turnOnFadeTime="1.5" turnOffFadeTime="2"/>
		</animationNodes>
		<productions sharedThroughputCapacity="false">
			<!-- Все 10 линий используют 25 циклов в час (600 за игровой месяц).
				 Мощность каждых двух молочных линий одного вида покрывает максимальный удой хозяйства.
				 Независимая пропускная способность сохраняет выбор активных рецептов за игроком. -->
			<production id="butter_milk" name="$l10n_milkProcessing_butter_milk" cyclesPerHour="25" costsPerActiveHour="1">
				<inputs>
					<input fillType="MILK" amount="40"/>
				</inputs>
				<outputs>
					<output fillType="BUTTER" amount="2" isPrimary="true"/>
					<output fillType="SKIMMED_MILK" amount="35.733333"/>
				</outputs>
			</production>
			<production id="butter_goatMilk" name="$l10n_milkProcessing_butter_goatMilk" cyclesPerHour="25" costsPerActiveHour="4">
				<inputs>
					<input fillType="GOATMILK" amount="11"/>
				</inputs>
				<outputs>
					<output fillType="GOATBUTTER" amount="0.44" isPrimary="true"/>
					<output fillType="SKIMMED_MILK" amount="9.9"/>
				</outputs>
			</production>
			<production id="butter_buffaloMilk" name="$l10n_milkProcessing_butter_buffaloMilk" cyclesPerHour="25" costsPerActiveHour="10">
				<inputs>
					<input fillType="BUFFALOMILK" amount="8"/>
				</inputs>
				<outputs>
					<output fillType="BUFFALOBUTTER" amount="0.43" isPrimary="true"/>
					<output fillType="SKIMMED_MILK" amount="6.666667"/>
				</outputs>
			</production>
			<production id="cheese" name="$l10n_milkProcessing_cheese" cyclesPerHour="25" costsPerActiveHour="1">
				<inputs>
					<input fillType="MILK" amount="40"/>
				</inputs>
				<outputs>
					<output fillType="CHEESE" amount="4"/>
				</outputs>
			</production>
			<production id="goatcheese" name="$l10n_milkProcessing_goatcheese" cyclesPerHour="25" costsPerActiveHour="4">
				<inputs>
					<input fillType="GOATMILK" amount="11"/>
				</inputs>
				<outputs>
					<output fillType="GOATCHEESE" amount="1.466667"/>
				</outputs>
			</production>
			<production id="buffalomozzarella" name="$l10n_milkProcessing_buffalomozzarella" cyclesPerHour="25" costsPerActiveHour="8">
				<inputs>
					<input fillType="BUFFALOMILK" amount="8"/>
				</inputs>
				<outputs>
					<output fillType="BUFFALOMOZZARELLA" amount="1.6"/>
				</outputs>
			</production>
			<production id="milkBottled" name="$l10n_milkProcessing_milkBottled" cyclesPerHour="25" costsPerActiveHour="1">
				<inputs>
					<input fillType="MILK" amount="40"/>
				</inputs>
				<outputs>
					<output fillType="MILK_BOTTLED" amount="39.6"/>
				</outputs>
			</production>
			<production id="goatmilkBottled" name="$l10n_milkProcessing_goatmilkBottled" cyclesPerHour="25" costsPerActiveHour="4">
				<inputs>
					<input fillType="GOATMILK" amount="11"/>
				</inputs>
				<outputs>
					<output fillType="GOATMILK_BOTTLED" amount="10.89"/>
				</outputs>
			</production>
			<production id="buffalomilkBottled" name="$l10n_milkProcessing_buffalomilkBottled" cyclesPerHour="25" costsPerActiveHour="8">
				<inputs>
					<input fillType="BUFFALOMILK" amount="8"/>
				</inputs>
				<outputs>
					<output fillType="BUFFALOMILK_BOTTLED" amount="7.92"/>
				</outputs>
			</production>
			<!-- Сушка обрата: 48 л обрата преобразуются в 9.6 л порошка за цикл; объёмная пропорция 5:1. -->
			<production id="skimmedMilkPowder" name="$l10n_milkProcessing_skimmedMilkPowder" cyclesPerHour="25" costsPerActiveHour="6" minRating="5">
				<inputs>
					<input fillType="SKIMMED_MILK" amount="48"/>
				</inputs>
				<outputs>
					<output fillType="SKIMMED_MILK_POWDER" amount="9.6"/>
				</outputs>
			</production>
			<!-- Сгущённое молоко: линия переработки коровьего молока с сахаром. -->
			<production id="condensedMilk" name="$l10n_milkProcessing_condensedMilk" cyclesPerHour="25" costsPerActiveHour="6" minRating="10">
				<inputs>
					<input fillType="MILK" amount="40"/>
					<input fillType="SUGAR" amount="8.5"/>
				</inputs>
				<outputs>
					<output fillType="CONDENSED_MILK" amount="14"/>
				</outputs>
			</production>
		</productions>
		<storage isExtension="false" fillLevelSyncThreshold="50">
			<capacity fillType="MILK" capacity="100000"/>
			<capacity fillType="GOATMILK" capacity="50000"/>
			<capacity fillType="BUFFALOMILK" capacity="50000"/>
			<capacity fillType="BUTTER" capacity="30000"/>
			<capacity fillType="GOATBUTTER" capacity="30000"/>
			<capacity fillType="BUFFALOBUTTER" capacity="30000"/>
			<!-- Обрат из маслобойных линий поступает в хранилище для последующей сушки. -->
			<capacity fillType="SKIMMED_MILK" capacity="30000"/>
			<capacity fillType="SKIMMED_MILK_POWDER" capacity="30000"/>
			<capacity fillType="SUGAR" capacity="30000"/>
			<capacity fillType="CONDENSED_MILK" capacity="30000"/>
			<capacity fillType="CHEESE" capacity="30000"/>
			<capacity fillType="GOATCHEESE" capacity="30000"/>
			<capacity fillType="BUFFALOMOZZARELLA" capacity="30000"/>
			<capacity fillType="MILK_BOTTLED" capacity="30000"/>
			<capacity fillType="GOATMILK_BOTTLED" capacity="30000"/>
			<capacity fillType="BUFFALOMILK_BOTTLED" capacity="30000"/>
		</storage>
		<sellingStation node="productionPoint" supportsExtension="false" hideFromPricesMenu="true" suppressWarnings="true" allowMissions="false" appearsOnStats="true">
			<supportedFillTypes>
				<fillType name="MILK"/>
				<fillType name="GOATMILK"/>
				<fillType name="BUFFALOMILK"/>
			</supportedFillTypes>
			<unloadTrigger exactFillRootNode="exactFillRootNodeWater" aiNode="unloadTriggerAINodeWater" fillTypes="MILK GOATMILK BUFFALOMILK"/>
			<palletTrigger triggerNode="productionPalletTrigger" aiNode="productionPalletAiNode" fillTypes="GOATMILK BUFFALOMILK SUGAR"/>
		</sellingStation>
		<palletSpawner node="palletSpawner">
			<spawnPlaces>
				<spawnPlace startNode="spawnSpaceStart01" endNode="spawnSpaceEnd01"/>
			</spawnPlaces>
		</palletSpawner>
		<playerTrigger node="playerTrigger"/>
	</productionPoint>

	<!-- Склад готовой продукции и ингредиентов на паллетах. -->
	<objectStorage isExtension="true" supportsExtension="false" supportsBales="false" supportsPallets="true" capacity="120" maxUnloadAmount="25" maxLength="8.5" maxWidth="6" maxHeight="4"
				   fillTypes="GOATMILK BUFFALOMILK BUTTER GOATBUTTER BUFFALOBUTTER CHEESE GOATCHEESE BUFFALOMOZZARELLA MILK_BOTTLED GOATMILK_BOTTLED BUFFALOMILK_BOTTLED SKIMMED_MILK_POWDER SUGAR CONDENSED_MILK">
		<playerTrigger node="storagePlayerTrigger"/>
		<objectTrigger node="storagePalletTrigger"/>
		<transferFromStorage playerTrigger="transferFromStorageTrigger">
			<destination fillType="GOATMILK" target="productionStorage" actionText="В производство"/>
			<destination fillType="BUFFALOMILK" target="productionStorage" actionText="В производство"/>
			<destination fillType="SUGAR" target="productionStorage" actionText="В производство"/>
		</transferFromStorage>
		<spawnAreas>
			<spawnArea startNode="spawnAreaStart_Row1" endNode="spawnAreaEnd_Row1" maxHeight="3"/>
			<spawnArea startNode="spawnAreaStart_Row2" endNode="spawnAreaEnd_Row2" maxHeight="3"/>
		</spawnAreas>
		<storageAreas>
			<storageArea startNode="storageAreaStart_Row1_part01" endNode="storageAreaEnd_Row1_part01" maxHeight="1.3"/>
			<storageArea startNode="storageAreaStart_Row1_part02" endNode="storageAreaEnd_Row1_part02" maxHeight="1.3"/>
			<storageArea startNode="storageAreaStart_Row1_part03" endNode="storageAreaEnd_Row1_part03" maxHeight="1.3"/>
			<storageArea startNode="storageAreaStart_Row1_part04" endNode="storageAreaEnd_Row1_part04" maxHeight="1.3"/>
		</storageAreas>
	</objectStorage>

		<triggerMarkers>
		<triggerMarker node="constructibleUnloadTriggerMarker" adjustToGround="true" filename="markerIcons/markerIconStroyka.i3d"/>
		<triggerMarker node="playerTriggerMarker" adjustToGround="false" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
		<!-- Приём сырья в производство и размещение паллет на складе. -->
		<triggerMarker node="productionPalletUnloadMarker" adjustToGround="false" filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
		<triggerMarker node="milkUnloadMarker" adjustToGround="false" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
		<triggerMarker node="storagePalletUnloadMarker" adjustToGround="false" filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
		<triggerMarker node="storagePlayerTriggerMarker" adjustToGround="false" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
		<triggerMarker node="transferFromStorageTriggerMarker" adjustToGround="false" filename="markerIcons/markerIconBaleToProduction.i3d"/>
	</triggerMarkers>

	<hotspots>
		<hotspot type="UNLOADING_PALLET" linkNode="constructibleUnloadTriggerMarker" teleportNode="constructibleUnloadTriggerMarker"/>
		<hotspot type="PRODUCTION_POINT" linkNode="playerTriggerMarker" teleportNode="playerTriggerMarker"/>
	</hotspots>

		<animatedObjects>
		<!-- Подъёмные ворота: проверенная механика MonomixProductionWorkshop. -->
		<animatedObject saveId="milkProcessingRollingDoor">
			<animation duration="5">
				<part node="rollingDoor1"><keyFrame time="0" translation="0 0 0"/><keyFrame time="1" translation="0 3.8 0"/></part>
				<part node="rollingDoor1ColPartBottom"><keyFrame time="0" translation="0 0 0"/><keyFrame time="1" translation="0 3.8 0"/></part>
				<part node="rollingDoor1ColPartTop"><keyFrame time="0" translation="0 0 0"/><keyFrame time="0.5" translation="0 0 0"/><keyFrame time="1" translation="0 1.9 0"/></part>
				<shader node="rollingDoor1" parameterName="visibilityCutThreshold"><keyFrame time="0" values="0 - - -"/><keyFrame time="1" values="0.94 - - -"/></shader>
			</animation>
			<controls triggerNode="rollingDoor1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
			<sounds>
				<moving linkNode="rollingDoor1Base" template="rollingGarageDoor"/>
				<posEnd linkNode="rollingDoor1Base" template="slidingGateMetalOpen"/>
				<negEnd linkNode="rollingDoor1Base" template="slidingGateMetalClose"/>
			</sounds>
		</animatedObject>
		<!-- Углы распашных дверей предварительные, подлежат проверке в игре. -->
		<animatedObject saveId="milkProcessingExternalDoor">
			<animation duration="1.2"><part node="externalDoor"><keyFrame time="0" rotation="0 0 0"/><keyFrame time="1" rotation="0 90 0"/></part></animation>
			<controls triggerNode="externalDoorTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
		</animatedObject>
		<animatedObject saveId="milkProcessingInternalDoor">
			<animation duration="1.2"><part node="internalDoor"><keyFrame time="0" rotation="0 0 0"/><keyFrame time="1" rotation="0 -90 0"/></part></animation>
			<controls triggerNode="internalDoorTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
		</animatedObject>
	</animatedObjects>

	<constructible>
		<stateMachine>
			<states>
				<state name="SETUP" class="ConstructibleStateBuilding" StateName="Монтаж арматуры">
					<!-- Функциональные узлы активируются только после завершения строительства. -->
					<toggleMesh node="productionPoint" active="false" updatePhysics="true"/>
					<toggleMesh node="storage" active="false" updatePhysics="true"/>
					<toggleMesh node="constructibleSellingStation" active="true" updatePhysics="true"/>
					<toggleHotspot index="1" isVisible="true"/>
					<toggleHotspot index="2" isVisible="false"/>

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_01" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_01_props01" updatePhysics="true" progressStepMin="1" progressStepMax="34"/>
					<toggleProgressMesh node="phase_01_props02" updatePhysics="true" progressStepMin="33" progressStepMax="67"/>
					<toggleProgressMesh node="phase_01_props03" updatePhysics="true" progressStepMin="66" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="48" usagePerHour="16"/>
					<input fillType="BUILDING_METAL" amount="4990" usagePerHour="1663.333333"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>
				<state name="BUILDING_1" class="ConstructibleStateBuilding" StateName="Монтаж опалубки">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_02" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_02_props01" updatePhysics="true" progressStepMin="1" progressStepMax="34"/>
					<toggleProgressMesh node="phase_02_props02" updatePhysics="true" progressStepMin="33" progressStepMax="67"/>
					<toggleProgressMesh node="phase_02_props03" updatePhysics="true" progressStepMin="66" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="48" usagePerHour="24"/>
					<input fillType="BOARDS" amount="995" usagePerHour="497.5"/>
					<input fillType="PLANKS" amount="3995" usagePerHour="1997.5"/>
					<input fillType="NAILS" amount="98" usagePerHour="49"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_2" class="ConstructibleStateBuilding" StateName="Заливка фундамента">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_03" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_03_props01" updatePhysics="true" progressStepMin="0" progressStepMax="14"/>
					<toggleProgressMesh node="phase_03_props02" updatePhysics="true" progressStepMin="14" progressStepMax="28"/>
					<toggleProgressMesh node="phase_03_props03" updatePhysics="true" progressStepMin="28" progressStepMax="42"/>
					<toggleProgressMesh node="phase_03_props04" updatePhysics="true" progressStepMin="42" progressStepMax="58"/>
					<toggleProgressMesh node="phase_03_props05" updatePhysics="true" progressStepMin="58" progressStepMax="72"/>
					<toggleProgressMesh node="phase_03_props06" updatePhysics="true" progressStepMin="72" progressStepMax="86"/>
					<toggleProgressMesh node="phase_03_props07" updatePhysics="true" progressStepMin="86" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="58" usagePerHour="5.8"/>
					<input fillType="CEMENT" amount="14990" usagePerHour="1499"/>
					<sounds>
						<active template="constructibleActive"/>
					</sounds>
				</state>
				<state name="BUILDING_3" class="ConstructibleStateBuilding" StateName="Возведение первого этажа">
					<!-- Прячем опалубку и арматуру -->
					<toggleMesh node="phase_01" active="false" updatePhysics="true"/>
					<toggleMesh node="phase_02" active="false" updatePhysics="true"/>
					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_04" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_04_props01" updatePhysics="true" progressStepMin="1" progressStepMax="26"/>
					<toggleProgressMesh node="phase_04_props02" updatePhysics="true" progressStepMin="25" progressStepMax="51"/>
					<toggleProgressMesh node="phase_04_props03" updatePhysics="true" progressStepMin="50" progressStepMax="76"/>
					<toggleProgressMesh node="phase_04_props04" updatePhysics="true" progressStepMin="75" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="240" usagePerHour="20"/>
					<input fillType="WOODBEAM" amount="19900" usagePerHour="1658.333333"/>
					<input fillType="NAILS" amount="440" usagePerHour="36.666667"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_4" class="ConstructibleStateBuilding" StateName="Монтаж межэтажного перекрытия">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_05" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_05_props01" updatePhysics="true" progressStepMin="0" progressStepMax="17"/>
					<toggleProgressMesh node="phase_05_props02" updatePhysics="true" progressStepMin="16" progressStepMax="33"/>
					<toggleProgressMesh node="phase_05_props03" updatePhysics="true" progressStepMin="32" progressStepMax="50"/>
					<toggleProgressMesh node="phase_05_props04" updatePhysics="true" progressStepMin="49" progressStepMax="67"/>
					<toggleProgressMesh node="phase_05_props05" updatePhysics="true" progressStepMin="66" progressStepMax="83"/>
					<toggleProgressMesh node="phase_05_props06" updatePhysics="true" progressStepMin="82" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="145" usagePerHour="29"/>
					<input fillType="PLANKS" amount="9990" usagePerHour="1998"/>
					<input fillType="NAILS" amount="295" usagePerHour="59"/>
					<sounds>
						<active template="carpenterSmallWork"/>
					</sounds>
				</state>
				<state name="BUILDING_5" class="ConstructibleStateBuilding" StateName="Возведение второго этажа">

					<!-- Основная геометрия стадии появляется по отдельным Shape в порядке Scenegraph. -->
					<toggleProgressMesh node="phase_06" active="true" updatePhysics="true" progressStepByStep="true"/>
					<toggleProgressMesh node="phase_06_props01" updatePhysics="true" progressStepMin="0" progressStepMax="27"/>
					<toggleProgressMesh node="phase_06_props02" updatePhysics="true" progressStepMin="23" progressStepMax="52"/>
					<toggleProgressMesh node="phase_06_props03" updatePhysics="true" progressStepMin="48" progressStepMax="77"/>
					<toggleProgressMesh node="phase_06_props04" updatePhysics="true" progressStepMin="73" progressStepMax="100"/>

					<input fillType="INSTRUMENT" amount="240" usagePerHour="20"/>
					<input fillType="WOODBEAM" amount="19900" usagePerHour="1658.333333"/>
					<input fillType="NAILS" amount="440" usagePerHour="36.666667"/>
					<sounds>
						<active template="carpenterSmallWork"/>

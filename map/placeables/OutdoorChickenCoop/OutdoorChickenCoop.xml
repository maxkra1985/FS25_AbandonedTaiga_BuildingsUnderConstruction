	<infoTrigger triggerNode="infoTrigger" />

	<husbandry saveId="Animals_CHICKEN" hasStatistics="false">
		<animals type="CHICKEN" maxNumAnimals="1000" maxNumVisualAnimals="500">
			<navigation rootNode="navigationRootNode" filename="map/placeables/OutdoorChickenCoop/navMesh.i3d" />
			<loadingTrigger node="loadingTrigger" />
		</animals>

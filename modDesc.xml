			<specialization name="constructible"/>
			<specialization name="objectStorage"/>
		</type>
		<!-- constructibleStorage - строимый склад -->
		<type name="constructibleStorage" parent="constructible" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="objectStorage"/>
		</type>
		<!-- constructibleBunkerSilo - строимый склад -->
		<type name="constructibleBunkerSilo" parent="constructible" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="bunkerSilo"/>
		</type>
		<!-- constructibleStorage - строимый склад -->
		<type name="constructibleRepairWorkshop" parent="constructible" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="workshop"/>
		</type>
		<!-- productionPointWithStorage - строимое производство со складом -->
		<type name="productionPointWithStorage" parent="productionPoint" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
			<specialization name="constructible"/>
			<specialization name="objectStorage"/>
			<specialization name="productionWarehouseSupply"/>
			<specialization name="meatAnimalInput"/>
		</type>
	</placeableTypes>
	<placeableSpecializations>
		<specialization name="productionWarehouseSupply" className="PlaceableProductionWarehouseSupply" filename="scripts/PlaceableProductionWarehouseSupply.lua"/>
		<specialization name="meatAnimalInput" className="PlaceableMeatAnimalInput" filename="scripts/FarmMeatIndustry/PlaceableMeatAnimalInput.lua"/>
	</placeableSpecializations>


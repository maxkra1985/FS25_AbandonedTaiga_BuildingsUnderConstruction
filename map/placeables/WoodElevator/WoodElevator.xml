<placeable type="constructibleProductionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>Деревянный элеватор</name>
		<functions>
			<function>Возводимый элеватор с зерноочистительным оборудованием, хранит зерновые и масличные культуры, убираемые зерноуборочным комбайном.</function>
			<function>Очищает пшеницу, ячмень, овёс и сорго с выделением зерновых отходов.</function>
			<function>Для строительства требуются инструменты, строительное железо, цемент, деревянные балки, доски, длинные доски, OSB плиты, листовое железо, отделка и гвозди.</function>
		</functions>
		<image>map/placeables/WoodElevator/storage_WoodElevator.dds</image>
		<price>100</price>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>ConstructibleBuildings</brand>
		<species>placeable</species>
		<category>productionPoints</category>
		<brush>
			<type>placeable</type>
			<category>ConstructibleBuildings</category>
			<tab>constructiblesStorage</tab>
		</brush>
		<storeIconRendering>
			<objectBundle>
				<object filename="map/placeables/WoodElevator/WoodElevator.i3d">
					<node node="0|1"/>
				</object>
			</objectBundle>
		</storeIconRendering>
	</storeData>

	<base>
		<filename>map/placeables/WoodElevator/WoodElevator.i3d</filename>
		<canBeRenamed>true</canBeRenamed>
		<canBeDeleted>true</canBeDeleted>
		<boughtWithFarmland>true</boughtWithFarmland>
	</base>


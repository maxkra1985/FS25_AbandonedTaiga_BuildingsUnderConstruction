<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="newFence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../shared/xml/schema/placeable.xsd">
	<storeData>
		<name>$l10n_shopItem_fence</name>
		<functions>
			<function>$l10n_function_decoration</function>
		</functions>
		<image>$data/placeables/brandless/fences/husbandries/cowFence/store_cowFence.png</image>
		<price>100</price>
		<dailyUpkeep>0</dailyUpkeep>
		<lifetime>1000</lifetime>
		<rotation>0</rotation>
		<brand>NONE</brand>
		<species>PLACEABLE</species>
		<category>fences</category>
		<canBeSold>true</canBeSold>
		<showInStore>false</showInStore>

		<vertexBufferMemoryUsage>33024</vertexBufferMemoryUsage>
		<indexBufferMemoryUsage>7936</indexBufferMemoryUsage>
		<textureMemoryUsage>327680</textureMemoryUsage>
		<instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
		<instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

		<brush>
			<type>newFence</type>
			<category>decoration</category>
			<tab>newFences</tab>
		</brush>

		<storeIconRendering>
			<settings centerIcon="true"/>
			<objectBundle>
				<object filename="map/placeables/fakeFence/fakeFence.i3d">
					<!-- poles -->
					<node node="0|0" translation="0 0 0" rotation="0 90 0" scale="1 1 1"/>
					<node node="0|0" translation="2 0 0" rotation="0 90 0" scale="1 1 1"/>
					<node node="0|0" translation="4 0 0" rotation="0 90 0" scale="1 1 1"/>

					<!-- panels -->
					<node node="1|0" translation="0 0 0" rotation="0 90 0" scale="1 1 1"/>
					<node node="1|0" translation="2 0 0" rotation="0 90 0" scale="1 1 1"/>
				</object>
			</objectBundle>
		</storeIconRendering>
		<audioMemoryUsage>0</audioMemoryUsage>
	</storeData>

	<base>
		<filename>map/placeables/fakeFence/fakeFence.i3d</filename>
	</base>

	<placement useRandomYRotation="false" useManualYRotation="true" >
		<sounds>
			<place template="fenceWoodImp" />
			<destroy template="destroyFence" />
		</sounds>
	</placement>

	<fence>
		<segment id="SEGMENT" class="FenceSegment" maxVerticalAngle="45">
			<poles>
				<pole node="pole01" radius="0.0"/>
			</poles>
			<panels maxScale="1.5">
				<panel node="panel01" length="2" />
			</panels>
		</segment>
	</fence>

	<i3dMappings>
		<i3dMapping id="pole01" node="0>" />
		<i3dMapping id="panel01" node="1>" />
	</i3dMappings>
</placeable>
